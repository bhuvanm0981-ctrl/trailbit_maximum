# Optional. Without it Trailbit uses GitHub's unauthenticated limits (10 searches a minute, 60 other requests an hour).
# Create a token with no scopes at https://github.com/settings/tokens to raise them (30 and 5,000).
GITHUB_TOKEN=

# --- Server (all optional) ---
# PORT defaults to 10000, Render's default. Render sets it for you.
# PORT=10000
# HOST defaults to 0.0.0.0 on Render and 127.0.0.1 elsewhere.
# HOST=127.0.0.1

# --- Database (all optional) ---
# Folder that holds trailbit.db. Defaults to the repository root.
# On Render, mount a persistent disk (for example at /var/data) and set DATA_DIR=/var/data
# or bookmarks are lost every time the service redeploys.
# DATA_DIR=/var/data
# Full SQLite URL, if you also want a different file name. Overrides DATA_DIR.
# DATABASE_URL=sqlite+aiosqlite:////var/data/trailbit.db

# --- TinyFish (optional) ---
# Used to read each repository's CONTRIBUTING guide so plans can quote its rules. Fetch is free up to 1,000 URLs a day.
# Without it everything still works; the plan just has no "From the contributing guide" section.
# Get a key at https://agent.tinyfish.ai/api-keys, then check it with:  python diagnose_tinyfish.py
TINYFISH_API_KEY=

# --- Hardening (all optional; the defaults are right for most deployments) ---
# CORS_ORIGINS=https://my-other-site.example     # only if a frontend hosted elsewhere calls the API; unset means same-origin only
# RATE_LIMIT_PER_MINUTE=120                      # requests per visitor per minute to /api
# RATE_LIMIT_HEAVY_PER_MINUTE=30                 # per visitor, for routes that call GitHub
# RATE_LIMIT_GLOBAL_PER_MINUTE=900               # across all visitors
# TRUST_PROXY=true                               # read the visitor's IP from X-Forwarded-For (on by default on Render)
# MAX_BODY_BYTES=16384                           # largest request body accepted
# MAX_BOOKMARKS=200                              # bookmarks one visitor may keep
# ENABLE_DOCS=true                               # serve /docs and /openapi.json (off by default on Render)
# SENTRY_DSN=                                    # report unhandled errors (also: pip install sentry-sdk)
